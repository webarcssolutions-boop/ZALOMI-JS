# Copy to .env and fill in (never commit .env)
PORT=4000
# Comma separated list of allowed website origins (your Expo web URL / domain)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://www.yourdomain.com

# Contact form email delivery (Gmail SMTP)
CONTACT_TO_EMAIL=webarcssolutions@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
# Use a Google App Password (not your regular Gmail password). Keep this secret.
SMTP_APP_PASSWORD=your-16-character-google-app-password

# Razorpay dashboard -> Settings -> API Keys (use TEST keys first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Razorpay dashboard -> Webhooks -> your secret
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Fee charged when no course-specific fee exists (rupees)
REGISTRATION_FEE=500
